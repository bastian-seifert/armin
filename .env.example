# ── Extraction: jev (TypeSafe System One) is the DEFAULT ─────────────────────
# Prose is split into sentences; each gets a typed Choice judgment (its
# durable-knowledge role: Decision, Rule, OpenItem, or noise). Kept sentences
# become VERBATIM nodes — hallucinated memory is impossible by construction —
# and a pairwise pass emits typed edges. No generative LLM, no JSON parsing.
#
# The one key you need for extraction:
TYPESAFE_AI_API_KEY=
# Optional:
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# ARMIN_JEV_MODEL=jev-1.13.0
#
# Alternative: route Jev via OpenRouter (same System One API, billed to the
# OpenRouter account; bare model ids map to the typesafe/ namespace, e.g.
# jev-latest → ~typesafe/jev-latest):
# ARMIN_JEV_PROVIDER=openrouter    # or "typesafe" — default: auto from keys
# OPENROUTER_API_KEY=sk-or-...
# ARMIN_JEV_BASE_URL=https://openrouter.ai/api
# ARMIN_JEV_MODEL=jev-latest
#
# Without a Typesafe/OpenRouter key the engine falls back to LLM extraction
# automatically (and to deterministic-only mode without any key at all).
#
# Opt out of Jev explicitly:
# ARMIN_EXTRACTION_MODE=llm
#
# Jev tuning (provisional for the minimal v2 criteria; Jev's calibration is
# prompt-sensitive — change wording and numbers together. See
# armin-core/extraction/src/jev.rs and data/backtest/):
# ARMIN_JEV_DECISION_THRESHOLD=0.65    # gate for kept nodes (Decision/Rule/OpenItem)
# ARMIN_JEV_EDGE_THRESHOLD=0.7         # min probability to keep a pairwise edge
# ARMIN_JEV_EDGE_MIN_OVERLAP=1         # shared content tokens for edge candidates
# ARMIN_JEV_MIN_SENTENCE_WORDS=6       # sentences below this are never judged
# ARMIN_JEV_MAX_SENTENCES=12           # cap on judged sentences per prose event

# ── LLM keys: optional with jev default ──────────────────────────────────────
# Used for /query answering, and as the automatic extraction fallback when
# no Typesafe key is set (or with ARMIN_EXTRACTION_MODE=llm).
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-4-6
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
#
# Optional: base URL overrides
# - Anthropic provider: ANTHROPIC_BASE_URL (Anthropic-style endpoint)
# - OpenAI provider:    OPENAI_BASE_URL (OpenAI-style endpoint)
#   Falls back to ANTHROPIC_BASE_URL if OPENAI_BASE_URL is unset, so
#   OpenAI-compatible gateways (OpenRouter, poe, …) work with either name.
#   A trailing /v1 in the URL is tolerated and stripped automatically.
#
# Example — OpenRouter via an OpenAI-compatible endpoint:
#   LLM_PROVIDER=openai
#   OPENAI_API_KEY=sk-or-...
#   OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   LLM_MODEL=z-ai/glm-4.6
#
# Example — poe OpenAI-compatible endpoint:
#   LLM_PROVIDER=openai
#   OPENAI_API_KEY=sk-poe-...
#   ANTHROPIC_BASE_URL=https://api.poe.com/v1
#   LLM_MODEL=glm-5.3-flash-el
#
# Note: gateways without function-calling support (e.g. poe) are handled
# automatically — extraction detects the ignored tool call and retries in
# JSON-in-content mode.

# ── LLM-mode-only knobs (ignored in jev mode) ────────────────────────────────
# Extraction thoroughness (extraction is ~0.3% of session cost, so richer
# budgets are effectively free — measured ~$0.005 for a 20-event backtest
# vs ~$2 for the session itself):
#   low    = terse, 1-4 nodes/event (batch 10 fits)
#   medium = one node per distinct item, up to 6/event (default)
#   high   = everything, up to 12/event (batch size auto-halved to fit the
#            output window; max output cap raised to 16k tokens)
# ARMIN_EXTRACT_BUDGET=medium
#
# Disable the resolution-linking pass (2nd cheap LLM call per batch that
# connects fresh answers to open items; jev emits Resolves edges itself):
# ARMIN_NO_LINKER=1
#
# LLM training data recording (JSONL path for distillation dataset):
# LLM_TRAINING_DATA_PATH=data/llm_training.jsonl

# ── Other optional integrations ──────────────────────────────────────────────
# Evidence grounding (Brave Search API):
# BRAVE_SEARCH_API_KEY=

# Server
SERVER_PORT=8080
