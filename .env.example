# LLM Provider (anthropic or openai)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6

# API Keys — set at least one
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: base URL overrides
# - Anthropic provider: ANTHROPIC_BASE_URL (Anthropic-style endpoint)
# - OpenAI provider:    OPENAI_BASE_URL (OpenAI-style endpoint)
#   Falls back to ANTHROPIC_BASE_URL if OPENAI_BASE_URL is unset, so
#   OpenAI-compatible gateways (OpenRouter, poe, …) work with either name.
#   A trailing /v1 in the URL is tolerated and stripped automatically.
#
# Example — OpenRouter via an OpenAI-compatible endpoint:
#   LLM_PROVIDER=openai
#   OPENAI_API_KEY=sk-or-...
#   OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   LLM_MODEL=z-ai/glm-4.6
#
# Example — poe OpenAI-compatible endpoint:
#   LLM_PROVIDER=openai
#   OPENAI_API_KEY=sk-poe-...
#   ANTHROPIC_BASE_URL=https://api.poe.com/v1
#   LLM_MODEL=glm-5.3-flash-el
#
# Note: gateways without function-calling support (e.g. poe) are handled
# automatically — extraction detects the ignored tool call and retries in
# JSON-in-content mode.

# Optional: evidence grounding (Brave Search API)
# BRAVE_SEARCH_API_KEY=

# Optional: extraction thoroughness (extraction is ~0.3% of session cost, so
# richer budgets are effectively free — measured ~$0.005 for a 20-event
# backtest vs ~$2 for the session itself).
#   low    = terse, 1-4 nodes/event (batch 10 fits)
#   medium = one node per distinct item, up to 6/event (default)
#   high   = everything incl. implicit assumptions, up to 12/event
#            (batch size is auto-halved to fit the output window;
#             max output cap raised to 16k tokens)
# ARMIN_EXTRACT_BUDGET=medium

# Optional: disable the resolution-linking pass (2nd cheap LLM call per
# batch that connects fresh answers to open questions)
# ARMIN_NO_LINKER=1

# Optional: LLM training data recording (JSONL path for distillation dataset)
# LLM_TRAINING_DATA_PATH=data/llm_training.jsonl

# ── Extraction mode (default: jev / TypeSafe System One) ─────────────────────
# Jev is the default extraction path: prose is split into sentences, each gets
# a typed Choice judgment (its durable-knowledge role: Decision, Rule,
# OpenItem, or noise). Kept sentences become VERBATIM nodes, and a pairwise
# pass emits typed edges. No generative LLM, no JSON truncation,
# hallucination impossible by construction.
#   jev = TypeSafe System One (default), llm = generative extraction opt-out
# Opt out of Jev with:
# ARMIN_EXTRACTION_MODE=llm
#
# Required for jev mode (falls back to LLM automatically when unset):
# TYPESAFE_AI_API_KEY=
# Optional:
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# ARMIN_JEV_MODEL=jev-1.13.0
#
# Tuning (provisional for the minimal v2 criteria; Jev's calibration is
# prompt-sensitive — change wording and numbers together. See
# armin-core/extraction/src/jev.rs and data/backtest/):
# ARMIN_JEV_DECISION_THRESHOLD=0.65    # gate for kept nodes (both types)
# ARMIN_JEV_EDGE_THRESHOLD=0.7         # min probability to keep a pairwise edge
# ARMIN_JEV_EDGE_MIN_OVERLAP=1         # shared content tokens for edge candidates
# ARMIN_JEV_MIN_SENTENCE_WORDS=6       # sentences below this are never judged
# ARMIN_JEV_MAX_SENTENCES=12           # cap on judged sentences per prose event

# Server
SERVER_PORT=8080
